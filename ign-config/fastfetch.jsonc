// IGOS Nusantara's fastfetch defaults (ign-config): its logo. A user's own
// ~/.config/fastfetch/config.jsonc takes the place of this one.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/ign-config/ign-fastfetch.txt"
    }
}
